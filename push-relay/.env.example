RELAY_PORT=8787
RELAY_PUBLISH_SECRET=replace-with-a-random-secret
VAPID_SUBJECT=mailto:push-admin@example.invalid
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
CORS_ORIGINS=https://sport.example
DATA_DIR=./data
